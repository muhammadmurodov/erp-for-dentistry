# ---------------------------------------------------------------------------
# Business ERP — example environment file.
# Copy to .env and replace every placeholder. Never commit .env.
# ---------------------------------------------------------------------------

APP_ENV=development            # development | test | production
APP_DEBUG=true
APP_NAME="Business ERP"
LOG_LEVEL=INFO
LOG_FORMAT=json                # json | console

# Database -------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=erp
POSTGRES_USER=erp
POSTGRES_PASSWORD=change-me-in-your-local-env

# Redis ---------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# Security ------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=generate-a-64-byte-random-value-do-not-use-this-one
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
PASSWORD_MIN_LENGTH=12
LOGIN_MAX_FAILED_ATTEMPTS=8
LOGIN_LOCKOUT_MINUTES=15

# CORS: comma-separated origins allowed to call the API.
# Note that http://localhost:5173 and http://127.0.0.1:5173 are *different*
# origins to a browser, so both loopback spellings are listed for development.
# In production, list only the real frontend origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate limiting (requests per window, per client+route group)
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_DEFAULT_PER_MINUTE=240

# Frontend ------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
